services:
  website:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "4000:4000"
    volumes:
      - .:/srv/jekyll
      - jekyll_cache:/srv/jekyll/.jekyll-cache
      - bundle_cache:/usr/local/bundle
    environment:
      - JEKYLL_ENV=development
      - PAGES_REPO_NWO=Server-Factory/Mail-Server-Factory-Website
    container_name: mail-server-factory-website
    restart: unless-stopped
    stdin_open: true
    tty: true

volumes:
  jekyll_cache:
  bundle_cache: